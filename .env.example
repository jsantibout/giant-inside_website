# Shopify Configuration
# Get these values from your Shopify Admin > Apps > Develop apps (for custom apps)
# Or from Settings > Apps and sales channels > Develop apps > Create an app
# These are SERVER-SIDE variables (no NEXT_PUBLIC_ prefix)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2024-10
REVALIDATE_SECRET=

# Resend Configuration
# Sign up at resend.com and get your API key
# Verify your domain to send emails
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Google Analytics (Optional)
# Create a GA4 property at analytics.google.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Site URL (Optional)
# Update with your actual domain when deploying
NEXT_PUBLIC_SITE_URL=https://www.yourdomain.com
